# WebWiz .gitignore
secrets.php
secrets.local.php
data/
logs/
*.sqlite
*.sqlite3
*.db
pending_magic/
# public/preview/ is generated sites - thousands of dirs, never committed.
# The two exceptions are small, hand-curated assets that a COMMITTED page
# (/o/_offer.php) now depends on, so a clean checkout must contain them:
#   showcase/*      - the static landing-page thumbnails that replaced the
#                     three live <iframe>s on 2026-08-05 (regenerate with
#                     private/qa-tools/showcase-thumbs.sh)
#   wizzy-wave.webp - 1.8KB header logo that replaced a 146KB GIF
public/preview/*
!public/preview/showcase/
!public/preview/wizzy-wave.webp
public/data/imgcache/
public/showcase_cache/
*.bak
*.bak.*
.bak/
/tmp/
*.log
node_modules/
package-lock.json.bak
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
private/sessions/
# Throwaway deploy helpers only (the token-gated _x_write.php pattern), NOT the
# permanent libraries. This rule used to be `public/api/_*.php`, which was added
# on 2026-07-14 to ignore "one-shot helpers" but also silently swallowed every
# real library in that directory. _email_templates.php, _meta.php, _nurture.php
# and _session.php only survive because they were committed BEFORE the rule
# existed and git does not ignore tracked files.
#
# It bit on 2026-08-11: a new public/api/_billing.php was written, `git add` said
# nothing, the commit went through without it, and the two files that require it
# would have fatalled on a clean checkout. Narrowed so the next library does not
# vanish the same way.
public/api/_x_*.php

# Sentry rollout (2026-07-29)
*.bak-*
*.bak_*
private/RELEASE

# Local pre-change backups (may contain a copy of secrets.php). NEVER commit.
backups/

# Claude Code agent worktrees: a full nested checkout (808 files / 15M when this
# was added). Never served, and one `git add -A` away from being committed.
# .claude/settings.json IS tracked on purpose - it carries the shared permission
# allow-list, including fix-webwiz-perms.sh (see gotcha 0 in CLAUDE.md).
.claude/worktrees/
